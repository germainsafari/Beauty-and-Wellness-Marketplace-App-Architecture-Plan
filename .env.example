# Neon PostgreSQL (required)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# OpenAI — powers Hafi AI beauty concierge
OPENAI_API_KEY=sk-proj-your-key-here

# API server (Render sets PORT automatically in production)
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string-in-production

# Comma-separated allowed web origins (set after Vercel deploy)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Web app (Vercel) — production API URL
VITE_API_URL=https://your-api.onrender.com

# Expo mobile — LAN IP for Expo Go on a physical device
EXPO_PUBLIC_API_URL=http://192.168.1.42:3001
